{
  "name": "yesplanner-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "admin:set": "node scripts/set-system-admin.mjs",
    "media:cleanup": "node scripts/cleanup-orphaned-media.mjs",
    "migrate:user-model": "node scripts/migrate-user-model.mjs",
    "seed:vendors": "node scripts/seed-vendors.mjs",
    "check:lines": "node scripts/check-file-lines.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "test:authorization": "node --no-warnings --experimental-strip-types --test --test-reporter=spec tests/auth/permissions.test.mjs",
    "test:api": "node --no-warnings --experimental-strip-types --test --test-reporter=spec tests/api/*.test.mjs",
    "test:i18n": "node --no-warnings --experimental-strip-types --test --test-reporter=spec tests/i18n/*.test.mjs",
    "test:ops": "node --no-warnings --experimental-strip-types --test --test-reporter=spec tests/scripts/*.test.mjs",
    "test:auth": "node --no-warnings --experimental-strip-types --test --test-reporter=spec tests/auth/country.test.mjs tests/auth/instagram.test.mjs tests/auth/register.test.mjs tests/auth/social-registration.test.mjs tests/auth/user-model.test.mjs",
    "test:unit": "npm run test:authorization && npm run test:api && npm run test:i18n && npm run test:ops && npm run test:auth",
    "test:e2e": "playwright test",
    "test:all": "node scripts/test-all.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run check:lines && npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.45.0",
    "moment": "^2.31.0",
    "mongodb": "^6.21.0",
    "next": "16.3.1",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "openai": "^7.27.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "react-phone-number-input": "^3.4.18",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
