# MongoDB-backed API mode is the foundation. Use "demo" only for the browser preview.
NEXT_PUBLIC_DATA_SOURCE=api
# Leave empty in production and staging so browser requests remain same-origin on both apex and www aliases.
# Set only when the API is hosted on a genuinely separate domain.
NEXT_PUBLIC_API_URL=

# Development database. Use a local server or a separate MongoDB Atlas development cluster.
MONGODB_DEVELOPMENT_URI=mongodb://127.0.0.1:27017
MONGODB_DEVELOPMENT_DATABASE=yes_planner_development
# Keep false for a standalone local MongoDB server. Use true for a replica set or Atlas.
MONGODB_USE_TRANSACTIONS=false

# Optional local-only country override for testing the ZAR display option. Use ZA or leave blank.
DEVELOPMENT_COUNTRY=

# Production must use separate credentials and a separate database or cluster.
MONGODB_PRODUCTION_URI=
MONGODB_PRODUCTION_DATABASE=yes_planner_staging

# Staging uses its own database and is selected with scripts using --env staging.
MONGODB_STAGING_URI=
MONGODB_STAGING_DATABASE=yes_planner_staging

# Generate a high-entropy value of at least 32 characters for every environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public URL used in invitation links and metadata. Production should use the canonical www host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated browser origins accepted by Better Auth. Include production, staging, and local development where needed.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://yes-planner.com,https://www.yes-planner.com,https://yes-planner-staging.vercel.app

# OAuth callbacks. In Google Cloud, register the exact callback for each deployment.
# Google:   http://localhost:3000/api/auth/callback/google
# Instagram: http://localhost:3000/api/auth/callback/instagram
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the Instagram App ID and App Secret from Meta's Instagram API with Instagram Login setup.
# This login is limited to Instagram Business and Creator accounts.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Resend transactional email. Verify the sender domain in Resend before sending.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Yes Planner <no-reply@your-verified-domain.com>"
EMAIL_BRAND_NAME="Yes Planner"
EMAIL_ACCENT_COLOR="#7a3348"

# Optional WhatsApp Business notification channel. The template must be approved and contain one body variable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFICATION_TEMPLATE=yes_planner_event
WHATSAPP_GRAPH_API_VERSION=v22.0
